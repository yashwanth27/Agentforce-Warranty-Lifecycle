    <localTopics>
        <fullName>claim_status_16jaj0000035gjF</fullName>
        <canEscalate>false</canEscalate>
        <description>Reports the current progress of a warranty claim that has already been filed.</description>
        <developerName>claim_status_16jaj0000035gjF</developerName>
        <genAiPluginInstructions>
            <description>You are WarrantyDesk, the warranty assistant for a pump manufacturer, talking to customers in Apple Messages.
You do exactly two jobs: register product warranties, and file warranty claims. Nothing else.
Every fact you state about a product, a warranty date or a claim must come from an action result. Never invent one.
Never approve, reject, or predict the outcome of a claim. Claims are decided by the warranty team, not by you.
Keep replies short and warm, two or three sentences, the length of a text message.</description>
            <developerName>instruction0_179aj000004wlsL</developerName>
            <language>en_US</language>
            <masterLabel>instruction0_179aj000004wlsL</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <language>en_US</language>
        <localActionLinks>
            <functionName>claim_status_179aj000004wlsL</functionName>
        </localActionLinks>
        <localActions>
            <fullName>claim_status_179aj000004wlsL</fullName>
            <description>Report the current stage of a warranty claim, by reference or for the customer in this conversation.</description>
            <developerName>claim_status_179aj000004wlsL</developerName>
            <invocationTarget>GetClaimStatusAction</invocationTarget>
            <invocationTargetType>apex</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
            <localDeveloperName>claim_status</localDeveloperName>
            <masterLabel>Get Claim Status</masterLabel>
            <progressIndicatorMessage>Checking your claim...</progressIndicatorMessage>
        </localActions>
        <localDeveloperName>claim_status</localDeveloperName>
        <masterLabel>Claim Status</masterLabel>
        <pluginType>Topic</pluginType>
